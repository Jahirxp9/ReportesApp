<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ReportesApp">

        <!-- Lista de Reportes (Pantalla Principal) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registro de Reporte -->
        <activity
            android:name=".ui.registro.RegistroReporteActivity"
            android:exported="false"
            android:label="@string/title_nuevo_reporte"
            android:parentActivityName=".MainActivity" />

        <!-- Detalle de Reporte -->
        <activity
            android:name=".ui.detalle.DetalleReporteActivity"
            android:exported="false"
            android:label="@string/title_detalle_reporte"
            android:parentActivityName=".MainActivity" />

        <!-- Búsqueda por DNI -->
        <activity
            android:name=".ui.busqueda.BusquedaDniActivity"
            android:exported="false"
            android:label="@string/title_buscar_dni"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>